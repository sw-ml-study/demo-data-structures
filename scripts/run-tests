#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
catalog="$repo_root/catalog/tests.tsv"
"$repo_root/scripts/validate-catalog" "$catalog"

count=$(awk -F '\t' 'NR > 1 && NF && $9 != "gated" { count++ } END { print count + 0 }' "$catalog")
[ "$count" -eq 0 ] && { echo "No data-structure tests registered yet."; exit 0; }

if [ -n "${MLPLUNIT:-}" ]; then runner=$MLPLUNIT
elif command -v mlplunit >/dev/null 2>&1; then runner=$(command -v mlplunit)
elif [ -x "$repo_root/../../softwarewrighter/mlplunit/bin/mlplunit" ]; then runner="$repo_root/../../softwarewrighter/mlplunit/bin/mlplunit"
else
  echo "mlplunit not found; set MLPLUNIT or add it to PATH" >&2
  exit 1
fi

mlpl=${MLPL:-"$repo_root/../sw-mlpl/target/release/mlpl-repl"}
[ -x "$mlpl" ] || { echo "mlpl-repl is not executable: $mlpl" >&2; exit 1; }

if [ "$#" -gt 0 ]; then
  exec "$runner" --mlpl "$mlpl" --config "$repo_root/mlplunit.conf" "$@"
fi

set --
while IFS="$(printf '\t')" read -r id path data_structure algorithm dynamic_size explicit_loops target_loops required_features status; do
  [ "$id" = "id" ] && continue
  [ -z "$id" ] && continue
  [ "$status" = "gated" ] && continue
  set -- "$@" "$repo_root/$path"
done < "$catalog"
exec "$runner" --mlpl "$mlpl" --config "$repo_root/mlplunit.conf" "$@"
