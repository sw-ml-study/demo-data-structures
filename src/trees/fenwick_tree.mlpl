# Immutable Fenwick tree with one-based internal indices and zero-based public indices.
def u:ft_lowbit(index) { "Return the largest power of two dividing a positive integer without bitwise primitives."; if eq(mod(index, 2), 1) { 1 } else { 2 * u:ft_lowbit(index / 2) } }
def u:ft_empty(size) { "Create zero-filled Fenwick values and internal tree arrays for size."; {size: size, values: fill([size], 0), tree: fill([size], 0)} }
def u:ft_add_tree(tree, internal_index, delta) { "Recursively add delta to affected one-based Fenwick ancestors."; if gt(internal_index, tally(tree)) { tree } else { u:ft_add_tree(scatter(tree, internal_index - 1, take(tree, 0, internal_index - 1) + delta), internal_index + u:ft_lowbit(internal_index), delta) } }
def u:ft_add(state, index, delta) { "Persistently add delta at a valid zero-based source index."; if eq(rank(index), 0) * eq(rank(delta), 0) { if eq(index, floor(index)) * (1 - lt(index, 0)) * lt(index, state.size) { ok({size: state.size, values: scatter(state.values, index, take(state.values, 0, index) + delta), tree: u:ft_add_tree(state.tree, index + 1, delta)}) } else { err({kind: "index", message: "Fenwick update index is outside the vector"}) } } else { err({kind: "update", message: "index and delta must be numeric scalars"}) } }
def u:ft_build_steps(state, values, index) { "Recursively add source values into a Fenwick tree."; if eq(index, tally(values)) { ok(state) } else { u:ft_build_steps(u:ft_add(state, index, take(values, 0, index))?, values, index + 1) } }
def u:ft_build(values) { "Build a Fenwick tree from a numeric vector, including empty input."; if eq(rank(values), 1) { u:ft_build_steps(u:ft_empty(tally(values)), values, 0) } else { err({kind: "values", message: "Fenwick input must be a vector"}) } }
def u:ft_prefix_steps(tree, internal_index, total) { "Accumulate a prefix by recursively clearing the lowest set-position contribution."; if eq(internal_index, 0) { total } else { u:ft_prefix_steps(tree, internal_index - u:ft_lowbit(internal_index), total + take(tree, 0, internal_index - 1)) } }
def u:ft_prefix_sum(state, end) { "Return the sum of the half-open source prefix [0,end)."; if eq(rank(end), 0) { if eq(end, floor(end)) * (1 - lt(end, 0)) * (1 - gt(end, state.size)) { ok(u:ft_prefix_steps(state.tree, end, 0)) } else { err({kind: "prefix", message: "prefix end is outside the vector"}) } } else { err({kind: "prefix", message: "prefix end must be an integer scalar"}) } }
def u:ft_range_sum(state, start, end) { "Return the sum of valid half-open source range [start,end)."; if eq(rank(start), 0) * eq(rank(end), 0) { if eq(start, floor(start)) * eq(end, floor(end)) * (1 - lt(start, 0)) * (1 - lt(end, start)) * (1 - gt(end, state.size)) { ok(u:ft_prefix_sum(state, end)? - u:ft_prefix_sum(state, start)?) } else { err({kind: "range", message: "range must be contained, ordered integer endpoints"}) } } else { err({kind: "range", message: "range endpoints must be integer scalars"}) } }
def u:ft_arrays_equal_at(left, right, index) { "Recursively compare equal-length numeric vectors from index onward."; if eq(index, tally(left)) { 1 } else { eq(take(left, 0, index), take(right, 0, index)) * u:ft_arrays_equal_at(left, right, index + 1) } }
def u:ft_valid(state) { "Validate size and internal aggregates by rebuilding from retained source values."; if eq(rank(state.values), 1) * eq(rank(state.tree), 1) * eq(tally(state.values), state.size) * eq(tally(state.tree), state.size) { u:ft_arrays_equal_at(state.tree, unwrap(u:ft_build(state.values)).tree, 0) } else { 0 } }
