#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
pattern='(sets|maps|hashing|heaps|caches)'
demo_count=$(awk -F '\t' -v pattern="$pattern" 'NR > 1 && $2 ~ ("^demos/" pattern "/") { count++ } END { print count + 0 }' "$repo_root/catalog/demos.tsv")
test_count=$(awk -F '\t' -v pattern="$pattern" 'NR > 1 && $2 ~ ("^tests/" pattern "/") { count++ } END { print count + 0 }' "$repo_root/catalog/tests.tsv")

[ "$demo_count" -eq 9 ] || { echo "expected 9 associative/priority demos, found $demo_count" >&2; exit 1; }
[ "$test_count" -eq 9 ] || { echo "expected 9 associative/priority tests, found $test_count" >&2; exit 1; }
[ ! -e "$repo_root/demos/sorts/batch_duration_heap_sort.mlpl" ] || { echo "heap sort must remain algorithm-owned" >&2; exit 1; }
[ -f "$repo_root/docs/modern-hashing-assessment.md" ] || { echo "missing foundational hashing assessment" >&2; exit 1; }

for kind in demos tests; do
  awk -F '\t' -v pattern="$pattern" 'NR > 1 && $2 ~ ("^" kind "/" pattern "/") { print $2 }' kind="$kind" "$repo_root/catalog/$kind.tsv" |
  while IFS= read -r path; do
    [ -f "$repo_root/$path" ] || { echo "missing migrated file: $path" >&2; exit 1; }
  done
done

echo "Associative/priority migration contract passed."
