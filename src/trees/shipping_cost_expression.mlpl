def u:empty_expr() {
  "Create an empty expr value.";
  {empty: 1}
}
def u:literal(value) {
  "Return the literal result for the supplied value.";
  {empty: 0, tag: 0, value: value}
}
def u:operation(tag, left, right) {
  "Return the operation result for the supplied tag, left, right.";
  {empty: 0, tag: tag, left: left, right: right}
}
def u:evaluate(expr) {
  "Return the evaluate result for the supplied expr.";
  if expr.empty {
    err({kind: "shape", message: "missing"})
  } else {
    if eq(expr.tag, 0) {
      ok(expr.value)
    } else {
      if lt(expr.tag, 1) + gt(expr.tag, 4) {
        err({kind: "tag", message: "invalid"})
      } else {
        left_value = u:evaluate(expr.left)?;
        right_value = u:evaluate(expr.right)?;
        if eq(expr.tag, 1) {
          ok(left_value + right_value)
        } else {
          if eq(expr.tag, 2) {
            ok(left_value - right_value)
          } else {
            if eq(expr.tag, 3) {
              ok(left_value * right_value)
            } else {
              if eq(right_value, 0) {
                err({kind: "division", message: "zero"})
              } else {
                ok(left_value / right_value)
              }
            }
          }
        }
      }
    }
  }
}
def u:prefix_tokens(expr) {
  "Return the prefix tokens result for the supplied expr.";
  if expr.empty {
    fill([0], 0)
  } else {
    if eq(expr.tag, 0) {
      [0, expr.value]
    } else {
      concat(reshape(expr.tag, [1]), concat(u:prefix_tokens(expr.left), u:prefix_tokens(expr.right)))
    }
  }
}
def u:count_nodes(expr) {
  "Return the count nodes result for the supplied expr.";
  if expr.empty {
    0
  } else {
    if eq(expr.tag, 0) {
      1
    } else {
      1 + u:count_nodes(expr.left) + u:count_nodes(expr.right)
    }
  }
}
