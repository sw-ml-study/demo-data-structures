include "src/maps/warehouse_direct_map.mlpl";

@test {name: "contract", tags: ["migration", "maps"]}
def u:test_contract() { "Run this script's conformance assertions.";
  empty = u:new_map(6);
  u:assert_true(u:valid(empty), "empty map invariant failed")?;
  u:assert_err(u:lookup(empty, 2), "empty lookup should miss")?;
  one = u:insert(empty, 2, 20)?;
  u:assert_eq(u:lookup(one, 2)?, 20, "insert lookup failed")?;
  u:assert_eq(one.size, 1, "insert size failed")?;
  updated = u:insert(one, 2, 25)?;
  u:assert_eq(u:lookup(updated, 2)?, 25, "duplicate-key update failed")?;
  u:assert_eq(updated.size, 1, "update should not grow size")?;
  zero = u:insert(updated, 5, 0)?;
  u:assert_eq(u:lookup(zero, 5)?, 0, "stored zero confused with absence")?;
  u:assert_eq(zero.size, 2, "boundary insert size failed")?;
  removed = u:remove(zero, 2)?;
  u:assert_err(u:lookup(removed, 2), "removed key should miss")?;
  u:assert_err(u:remove(removed, 2), "duplicate remove should fail")?;
  u:assert_eq(u:lookup(one, 2)?, 20, "later updates changed retained version")?;
  u:assert_err(u:insert(empty, -1, 1), "negative key should fail")?;
  u:assert_err(u:insert(empty, 6, 1), "past-end key should fail")?;
  u:assert_err(u:insert(empty, 1.5, 1), "fractional key should fail")?;
  u:assert_true(u:valid(removed), "removed map invariant failed")?;
  ok({test: "direct-address-map", cases: 15})
}

u:run_registered_tests()
