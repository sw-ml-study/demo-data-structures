def u:new_cache(capacity) {
  "Create an empty cache value.";
  {keys: fill([0], 0), values: fill([0], 0), previous: fill([0], 0), next_handles: fill([0], 0), active: fill([0], 0), head: -1, tail: -1, size: 0, nodes: 0, capacity: capacity}
}
def u:find_from(cache, key, position) {
  "Find from in the supplied structure.";
  if eq(position, cache.nodes) {
    -1
  } else {
    if eq(take(cache.active, 0, position), 1) * eq(take(cache.keys, 0, position), key) {
      position
    } else { u:find_from(cache, key, position + 1) }
  }
}
def u:find(cache, key) {
  "Find the requested value or node in the supplied structure.";
  u:find_from(cache, key, 0)
}
def u:detach(cache, node) {
  "Remove the supplied item and return the updated structure.";
  before = take(cache.previous, 0, node);
  after = take(cache.next_handles, 0, node);
  new_previous = if eq(after, -1) {
    cache.previous
  } else {
    scatter(cache.previous, after, before)
  };
  new_next = if eq(before, -1) {
    cache.next_handles
  } else {
    scatter(cache.next_handles, before, after)
  };
  {keys: cache.keys, values: cache.values, previous: scatter(new_previous, node, -1), next_handles: scatter(new_next, node, -1), active: cache.active, head: if eq(cache.head, node) {
      after
    } else {
      cache.head
    }, tail: if eq(cache.tail, node) {
      before
    } else {
      cache.tail
    }, size: cache.size, nodes: cache.nodes, capacity: cache.capacity}
}
def u:attach_front(cache, node) {
  "Add an item at the front and return the updated structure.";
  linked_previous = if eq(cache.head, -1) {
    cache.previous
  } else {
    scatter(cache.previous, cache.head, node)
  };
  {keys: cache.keys, values: cache.values, previous: scatter(linked_previous, node, -1), next_handles: scatter(cache.next_handles, node, cache.head), active: cache.active, head: node, tail: if eq(cache.tail, -1) {
      node
    } else {
      cache.tail
    }, size: cache.size, nodes: cache.nodes, capacity: cache.capacity}
}
def u:promote(cache, node) {
  "Return the promote result for the supplied cache, node.";
  if eq(cache.head, node) {
    cache
  } else { u:attach_front(u:detach(cache, node), node) }
}
def u:retire_tail(cache) {
  "Remove the supplied item and return the updated structure.";
  victim = cache.tail;
  detached_cache = u:detach(cache, victim);
  {keys: detached_cache.keys, values: detached_cache.values, previous: detached_cache.previous, next_handles: detached_cache.next_handles, active: scatter(detached_cache.active, victim, 0), head: detached_cache.head, tail: detached_cache.tail, size: cache.size - 1, nodes: cache.nodes, capacity: cache.capacity}
}
def u:append_front(cache, key, value) {
  "Add an item at the front and return the updated structure.";
  node = cache.nodes;
  extended = {keys: concat(cache.keys, key), values: concat(cache.values, value), previous: concat(cache.previous, -1), next_handles: concat(cache.next_handles, -1), active: concat(cache.active, 1), head: cache.head, tail: cache.tail, size: cache.size + 1, nodes: node + 1, capacity: cache.capacity};
  u:attach_front(extended, node)
}
def u:put(cache, key, value) {
  "Add the supplied item and return the updated structure.";
  node = u:find(cache, key);
  if gt(node, -1) { u:promote({keys: cache.keys, values: scatter(cache.values, node, value), previous: cache.previous, next_handles: cache.next_handles, active: cache.active, head: cache.head, tail: cache.tail, size: cache.size, nodes: cache.nodes, capacity: cache.capacity}, node) } else {
    base_cache = if eq(cache.size, cache.capacity) { u:retire_tail(cache) } else {
      cache
    };
    u:append_front(base_cache, key, value)
  }
}
def u:access(cache, key) {
  "Find the requested value or node in the supplied structure.";
  node = u:find(cache, key);
  if eq(node, -1) {
    err({kind: "missing", message: "absent"})
  } else {
    ok({cache: u:promote(cache, node), value: take(cache.values, 0, node)})
  }
}
def u:walk_keys(cache, handle, reverse, remaining) {
  "Traverse the supplied structure in walk keys order.";
  if eq(handle, -1) + eq(remaining, 0) {
    fill([0], 0)
  } else {
    next_handle = if reverse {
      take(cache.previous, 0, handle)
    } else {
      take(cache.next_handles, 0, handle)
    };
    concat(take(cache.keys, 0, handle), u:walk_keys(cache, next_handle, reverse, remaining - 1))
  }
}
def u:forward(cache) {
  "Return the forward result for the supplied cache.";
  u:walk_keys(cache, cache.head, 0, cache.size)
}
def u:reverse(cache) {
  "Return the reverse result for the supplied cache.";
  u:walk_keys(cache, cache.tail, 1, cache.size)
}
def u:count(flags, wanted, position) {
  "Return the count result for the supplied flags, wanted, position.";
  if eq(position, tally(flags)) {
    0
  } else {
    eq(take(flags, 0, position), wanted) + u:count(flags, wanted, position + 1)
  }
}
def u:chain_ok(cache, handle, expected, reverse, steps) {
  "Check whether cache, handle, expected, reverse, steps satisfies the chain ok invariant.";
  if eq(handle, -1) {
    eq(steps, cache.size)
  } else {
    if eq(steps, cache.size) {
      0
    } else {
      if lt(handle, 0) + gt(handle, cache.nodes - 1) {
        0
      } else {
        link = if reverse {
          take(cache.next_handles, 0, handle)
        } else {
          take(cache.previous, 0, handle)
        };
        next_handle = if reverse {
          take(cache.previous, 0, handle)
        } else {
          take(cache.next_handles, 0, handle)
        };
        eq(take(cache.active, 0, handle), 1) * eq(link, expected) * u:chain_ok(cache, next_handle, handle, reverse, steps + 1)
      }
    }
  }
}
def u:valid(cache) {
  "Check whether cache satisfies the valid invariant.";
  shapes = eq(tally(cache.keys), cache.nodes) * eq(tally(cache.values), cache.nodes) * eq(tally(cache.previous), cache.nodes) * eq(tally(cache.next_handles), cache.nodes) * eq(tally(cache.active), cache.nodes);
  if shapes {
    eq(u:count(cache.active, 1, 0), cache.size) * u:chain_ok(cache, cache.head, -1, 0, 0) * u:chain_ok(cache, cache.tail, -1, 1, 0)
  } else {
    0
  }
}
