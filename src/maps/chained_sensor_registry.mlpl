def u:new_map(capacity) {
  "Create an empty map value.";
  {heads: fill([capacity], -1), keys: fill([0], 0), values: fill([0], 0), next_handles: fill([0], 0), active: fill([0], 0), capacity: capacity, size: 0, nodes: 0}
}
def u:norm(key) {
  "Return the norm result for the supplied key.";
  if lt(key, 0) {
    0 - key * 2 - 1
  } else {
    key * 2
  }
}
def u:rem(value, divisor) {
  "Return the rem result for the supplied value, divisor.";
  value - floor(value / divisor) * divisor
}
def u:bucket(key, capacity) {
  "Return the bucket result for the supplied key, capacity.";
  u:rem(u:norm(key) * 37 + 17, capacity)
}
def u:find_from(map, key, handle, steps) {
  "Find from in the supplied structure.";
  if eq(handle, -1) + eq(steps, map.nodes) {
    -1
  } else {
    if eq(take(map.active, 0, handle), 1) * eq(take(map.keys, 0, handle), key) {
      handle
    } else { u:find_from(map, key, take(map.next_handles, 0, handle), steps + 1) }
  }
}
def u:find(map, key) {
  "Find the requested value or node in the supplied structure.";
  u:find_from(map, key, take(map.heads, 0, u:bucket(key, map.capacity)), 0)
}
def u:raw_insert(map, key, value) {
  "Return the raw insert result for the supplied map, key, value.";
  bucket = u:bucket(key, map.capacity);
  node = map.nodes;
  {heads: scatter(map.heads, bucket, node), keys: concat(map.keys, key), values: concat(map.values, value), next_handles: concat(map.next_handles, take(map.heads, 0, bucket)), active: concat(map.active, 1), capacity: map.capacity, size: map.size + 1, nodes: node + 1}
}
def u:rehash(old_map, position, fresh_map) {
  "Return the rehash result for the supplied old_map, position, fresh_map.";
  if eq(position, old_map.nodes) {
    fresh_map
  } else {
    if eq(take(old_map.active, 0, position), 1) { u:rehash(old_map, position + 1, u:raw_insert(fresh_map, take(old_map.keys, 0, position), take(old_map.values, 0, position))) } else { u:rehash(old_map, position + 1, fresh_map) }
  }
}
def u:put(map, key, value) {
  "Add the supplied item and return the updated structure.";
  node = u:find(map, key);
  if gt(node, -1) {
    {heads: map.heads, keys: map.keys, values: scatter(map.values, node, value), next_handles: map.next_handles, active: map.active, capacity: map.capacity, size: map.size, nodes: map.nodes}
  } else {
    if gt(map.size + 1, map.capacity) { u:raw_insert(u:rehash(map, 0, u:new_map(map.capacity * 2 + 1)), key, value) } else { u:raw_insert(map, key, value) }
  }
}
def u:get(map, key) {
  "Find the requested value or node in the supplied structure.";
  node = u:find(map, key);
  if eq(node, -1) {
    err({kind: "missing", message: "absent"})
  } else {
    ok(take(map.values, 0, node))
  }
}
def u:locate(map, key, handle, previous, steps) {
  "Find the requested value or node in the supplied structure.";
  if eq(handle, -1) + eq(steps, map.nodes) {
    {index: -1, previous: -1}
  } else {
    if eq(take(map.active, 0, handle), 1) * eq(take(map.keys, 0, handle), key) {
      {index: handle, previous: previous}
    } else { u:locate(map, key, take(map.next_handles, 0, handle), handle, steps + 1) }
  }
}
def u:remove(map, key) {
  "Remove the supplied item and return the updated structure.";
  bucket = u:bucket(key, map.capacity);
  place = u:locate(map, key, take(map.heads, 0, bucket), -1, 0);
  if eq(place.index, -1) {
    err({kind: "missing", message: "absent"})
  } else {
    successor = take(map.next_handles, 0, place.index);
    new_heads = if eq(place.previous, -1) {
      scatter(map.heads, bucket, successor)
    } else {
      map.heads
    };
    new_next = if eq(place.previous, -1) {
      map.next_handles
    } else {
      scatter(map.next_handles, place.previous, successor)
    };
    ok({heads: new_heads, keys: map.keys, values: map.values, next_handles: new_next, active: scatter(map.active, place.index, 0), capacity: map.capacity, size: map.size - 1, nodes: map.nodes})
  }
}
def u:count(values, wanted, position) {
  "Return the count result for the supplied values, wanted, position.";
  if eq(position, tally(values)) {
    0
  } else {
    eq(take(values, 0, position), wanted) + u:count(values, wanted, position + 1)
  }
}
def u:handles_ok(map, position) {
  "Check whether map, position satisfies the handles ok invariant.";
  if eq(position, map.nodes) {
    1
  } else {
    handle = take(map.next_handles, 0, position);
    (eq(handle, -1) + (gt(handle, -1) * lt(handle, map.nodes))) * u:handles_ok(map, position + 1)
  }
}
def u:valid(map) {
  "Check whether map satisfies the valid invariant.";
  eq(tally(map.heads), map.capacity) * eq(tally(map.keys), map.nodes) * eq(tally(map.values), map.nodes) * eq(tally(map.next_handles), map.nodes) * eq(tally(map.active), map.nodes) * eq(u:count(map.active, 1, 0), map.size) * u:handles_ok(map, 0)
}
