#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cmp -s "$repo_root/COPYRIGHT" "$repo_root/../demo-algorithms/COPYRIGHT" || { echo "COPYRIGHT differs from demo-algorithms" >&2; exit 1; }
cmp -s "$repo_root/LICENSE" "$repo_root/../demo-algorithms/LICENSE" || { echo "LICENSE differs from demo-algorithms" >&2; exit 1; }
"$repo_root/scripts/validate-catalog" "$repo_root/catalog/demos.tsv"
"$repo_root/scripts/validate-catalog" "$repo_root/catalog/tests.tsv"
"$repo_root/scripts/run-all" >/dev/null
"$repo_root/scripts/run-tests" >/dev/null
grep -q 'agentrail next' "$repo_root/AGENTS.md"
grep -q 'agentrail next' "$repo_root/CLAUDE.md"
echo "Bootstrap contract passed."
